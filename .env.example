# =============================================================================
# CAREERLENS — Environment Variables Template
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env:     copy .env.example .env
#   2. Fill in values in .env only — NEVER in this file
#   3. NEVER commit .env to version control
#   4. .env is already covered by .gitignore
#   5. This file (.env.example) MUST ONLY contain placeholder values
#
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=
APP_DEBUG=true


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://careerlens_user:PASSWORD@localhost:5432/careerlens_db
TEST_DATABASE_URL=postgresql+asyncpg://careerlens_user:PASSWORD@localhost:5432/careerlens_test


# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# LLM PROVIDER
# -----------------------------------------------------------------------------
# Options: gemini | openai | none
#
# 'none' means all LLM tasks use deterministic/template fallbacks.
# The system is fully functional with LLM_PROVIDER=none.
# Set to 'gemini' or 'openai' only when the corresponding API key is available.
# Gemini pricing and availability are subject to change — do not assume free tier.
#
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# EMBEDDINGS
# -----------------------------------------------------------------------------
# Options: local | openai
#
# 'local' uses sentence-transformers (all-MiniLM-L6-v2) — free, runs offline.
# 'openai' uses OpenAI text-embedding-3-small — requires OPENAI_API_KEY.
#
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384


# -----------------------------------------------------------------------------
# HYBRID MATCH WEIGHTS
# -----------------------------------------------------------------------------
# All six values MUST sum to exactly 1.0.
# This is validated at application startup.
#
MATCH_WEIGHT_SEMANTIC=0.35
MATCH_WEIGHT_SKILL_OVERLAP=0.25
MATCH_WEIGHT_EXPERIENCE=0.15
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_LOCATION_WORKMODE=0.10
MATCH_WEIGHT_EMPLOYMENT_TYPE=0.05


# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
RESUME_UPLOAD_DIR=./data/uploads/resumes
MAX_RESUME_SIZE_MB=10
MAX_RESUME_FILE_SIZE_MB=10


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# OPTIONAL: JOB DATA APIs
# -----------------------------------------------------------------------------
# Required only if using external job data sources (Phase 14+)
# Leave blank to use synthetic dataset only.
#
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
