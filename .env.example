# =============================================================================
# CAREERLENS — Environment Variables Template
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env:     copy .env.example .env   (Windows)
#                                  cp .env.example .env     (Linux/macOS)
#   2. Fill in values in .env only — NEVER commit real credentials to Git.
#   3. For Docker Compose: variables defined here are picked up automatically.
#   4. Production requirement: JWT_SECRET_KEY must be >= 32 characters, and
#      DEBUG must be false.
#
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# -----------------------------------------------------------------------------
# Environment options: production | development | test
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# DATABASE CREDENTIALS (DOCKER COMPOSE & STANDALONE POSTGRESQL)
# -----------------------------------------------------------------------------
# Database container settings
POSTGRES_USER=careerlens_user
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=careerlens_db
POSTGRES_PORT=5432
POSTGRES_BIND_IP=127.0.0.1

# SQLAlchemy connection strings (asyncpg)
# In Docker Compose, host is 'db': postgresql+asyncpg://<user>:<password>@db:5432/<database>
# In local development without Docker, host is 'localhost':
DATABASE_URL=postgresql+asyncpg://careerlens_user:PASSWORD@localhost:5432/careerlens_db
TEST_DATABASE_URL=postgresql+asyncpg://careerlens_user:PASSWORD@localhost:5432/careerlens_test


# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Operator MUST supply a cryptographically secure key with >= 32 characters in production.
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# NETWORKING & PORTS
# -----------------------------------------------------------------------------
# External ports exposed to host machine
FRONTEND_PORT=80
BACKEND_PORT=8000
BACKEND_BIND_IP=127.0.0.1

# Allowed origins for CORS (comma-separated or list)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:80,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:80,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# EMBEDDINGS & VECTOR SEARCH
# -----------------------------------------------------------------------------
# Options: local | openai
# 'local' uses CPU sentence-transformers (all-MiniLM-L6-v2) — offline, no external API keys.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384


# -----------------------------------------------------------------------------
# LLM PROVIDER (OPTIONAL)
# -----------------------------------------------------------------------------
# Options: none | gemini | openai
# 'none' enables deterministic / rule-based fallbacks. CareerLens is 100% functional with none.
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# FILE STORAGE & RESUME PARSING
# -----------------------------------------------------------------------------
RESUME_UPLOAD_DIR=./data/uploads/resumes
MAX_RESUME_SIZE_MB=10
MAX_RESUME_FILE_SIZE_MB=10


# -----------------------------------------------------------------------------
# HYBRID MATCH WEIGHTS (FROZEN SPECIFICATION — MUST SUM TO 1.0)
# -----------------------------------------------------------------------------
MATCH_WEIGHT_SEMANTIC=0.35
MATCH_WEIGHT_SKILL_OVERLAP=0.25
MATCH_WEIGHT_EXPERIENCE=0.15
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_LOCATION_WORKMODE=0.10
MATCH_WEIGHT_EMPLOYMENT_TYPE=0.05


# -----------------------------------------------------------------------------
# PHASE 26 — EXTERNAL OPPORTUNITY CONNECTORS
# -----------------------------------------------------------------------------
# Wave 1 Connectors (Phase 26.3):
# Remotive, Arbeitnow, and Codeforces use public APIs requiring no credentials.
#
# Greenhouse Public Job Boards:
#   Comma-separated list of Greenhouse employer board tokens (slugs).
#   These are PUBLIC board identifiers, NOT secret credentials.
#   Find board tokens from the employer's Greenhouse hosted board URL:
#     e.g. https://boards.greenhouse.io/stripe -> token is "stripe"
#   Leave empty to disable the Greenhouse connector (it will report NOT_CONFIGURED).
GREENHOUSE_BOARD_TOKENS=razorpaysoftwareprivatelimited,commerceiq,gitlab,sonicwall

# Wave 2 Connectors (Phase 26.4):
# Adzuna Developer API:
#   Application ID and key obtained from https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# USAJOBS Developer API:
#   API key and registered email obtained from https://developer.usajobs.gov
USAJOBS_API_KEY=your_usajobs_api_key
USAJOBS_EMAIL=your_usajobs_registration_email

# Lever Public Job Postings (Phase 26.4):
#   Comma-separated list of company slugs utilizing Lever for job postings.
#   These are PUBLIC site identifiers, NOT secret credentials.
#   e.g. https://jobs.lever.co/spotify -> slug is "spotify"
#   Leave empty to disable the Lever connector (it will report NOT_CONFIGURED).
LEVER_SITE_TOKENS=spotify,palantir

# Remote OK Public Feed (Phase 26.4):
#   Uses public feed at https://remoteok.com/api with required attribution.
#   No API keys required.


# -----------------------------------------------------------------------------
# PHASE 26.5 — CONNECTOR SCHEDULER & BACKGROUND SYNCHRONIZATION
# -----------------------------------------------------------------------------
# Background Scheduler:
#   Set to true in production/worker runtimes to activate the periodic synchronization loop.
#   Defaults to false in local development and test suites to prevent unexpected background jobs.
SCHEDULER_ENABLED=false
#
# Polling interval in seconds to evaluate due connectors (default: 60)
SCHEDULER_INTERVAL_SECONDS=60
#
# Maximum concurrent connector synchronizations running in parallel (default: 2)
SCHEDULER_MAX_CONCURRENCY=2
#
# Per-connector execution timeout in seconds before aborting (default: 300)
CONNECTOR_TIMEOUT_SECONDS=300
#
# Stale lock threshold in minutes for reclaiming runs from crashed workers (default: 30)
CONNECTOR_STALE_LOCK_MINUTES=30
#
# Default connector refresh interval in minutes when not overridden in DB (default: 60)
CONNECTOR_DEFAULT_REFRESH_MINUTES=60

